# Frontend configuration. Vite reads .env.local (gitignored) at build time and
# bakes the values into the bundle — these are not read at runtime, so changing
# one means building again.

# Where the API lives, without the /api suffix.
#
# Three cases, and the difference between the last two matters:
#   unset           → http://localhost:8000, the development default
#   VITE_API_ORIGIN=                → *same origin* as the page. Use this when
#                                     the Go server serves this bundle itself
#                                     (its STATIC_DIR). Nothing is cross-origin,
#                                     so no CORS_ORIGINS is needed either.
#   VITE_API_ORIGIN=https://api.example.az
#                                   → a different host. That origin must then
#                                     list this site in the backend's
#                                     CORS_ORIGINS, or every request fails.
#
# Set-but-empty is a real setting, not a missing one. Leaving the line below
# uncommented and blank is how you ask for same-origin.
VITE_API_ORIGIN=
