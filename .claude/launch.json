{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "library-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "library-frontend", "run", "dev"],
      "port": 5180
    },
    {
      "name": "school-library-backend",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "."],
      "cwd": "school-library-system",
      "port": 8000
    },
    {
      "name": "deployed-shape",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "."],
      "cwd": "school-library-system",
      "env": {
        "PORT": "8081",
        "STATIC_DIR": "../library-frontend/dist",
        "CORS_ORIGINS": ""
      },
      "port": 8081
    }
  ]
}
