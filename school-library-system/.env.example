# Copy to .env (or export these in your shell) and fill in real values.
# The app falls back to insecure development defaults if these are unset,
# and logs a warning at startup. Always set them in production.

# Secret used to sign JWT auth tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Postgres connection string.
DATABASE_DSN=host=localhost user=postgres password=2334 dbname=school_library port=5432 sslmode=disable
